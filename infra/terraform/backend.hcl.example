# Copy to backend.hcl (git-ignored) and fill in. The state bucket must already exist, be private,
# versioned and encrypted; see docs/DEPLOYMENT.md for the one-time bootstrap.
bucket       = "your-terraform-state-bucket"
key          = "joblens/prod/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
