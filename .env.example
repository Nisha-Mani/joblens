POSTGRES_DB=joblens
POSTGRES_USER=joblens
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/joblens
# Required. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_MINUTES=60
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_PROVIDER=mock                    # mock (free, deterministic) or openai (needs OPENAI_API_KEY)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./data/uploads
S3_BUCKET=
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
VITE_API_BASE_URL=http://localhost:8080
ANALYSIS_RATE_LIMIT_PER_HOUR=20
